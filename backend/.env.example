# ── Vercel KV ────────────────────────────────────────────────────────
# Created automatically when you attach a KV database to this project
# from the Vercel dashboard: Project -> Storage -> Create Database -> KV
# -> Connect to Project. Vercel injects these for you — you normally
# do NOT need to set them by hand, this file just documents what exists.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# ── GitHub (for the "Replace HTML" admin feature) ───────────────────
# Personal Access Token with "repo" scope (classic) or Contents:
# Read & Write (fine-grained), scoped to your repo.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "your-username/your-repo-name"
GITHUB_REPO=your-username/your-repo-name
GITHUB_BRANCH=main
GITHUB_FILE_PATH=index.html

# ── Admin auth ───────────────────────────────────────────────────────
# Long random string. Required to use admin.html's "Replace HTML" action.
ADMIN_TOKEN=choose-a-long-random-secret
